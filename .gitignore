# compiled output
/dist
/node_modules
/build

# TypeScript build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Ferramentas de IA (geradas pelo prisma skills sync)
.agents/
# .claude/ fica ignorado, EXCETO a skill de documentação do projeto (versionada de propósito).
# Em camadas porque o Git não reinclui arquivos dentro de um diretório ignorado por inteiro.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/taskflow-docs/
.cursor/
.devin/

# Pasta de estudos pessoais
Estudo/

# Prisma generated client (se existir)
src/generated/

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Sobras de compilação na pasta prisma
prisma/*.js
prisma/*.d.ts
prisma/*.js.map

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/plan.out
terraform/crash.log

# Artefatos gerados pelos labs de Node internals (labs/node-internals/generate-file.js e copy-stream.js)
# Versionamos o script que gera, nunca o arquivo gerado (~100 MB cada)
labs/node-internals/*.txt
# Caminho antigo, mantido para quem ainda tiver os arquivos gerados num clone anterior à mudança
test/load/*.txt