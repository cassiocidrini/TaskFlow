generator client {
  provider        = "prisma-client-js"
  // partialIndexes: o índice das pendentes da outbox (WHERE published_at IS NULL) declarado AQUI. Criado só no
  // SQL da migração, o `migrate dev` o veria como drift e geraria um DROP INDEX na migração seguinte.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  tasks     Task[]
  projects  Project[]
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Dono do projeto: base de toda regra de autorização (OWASP A01).
  // onDelete: Restrict → apagar um usuário com projetos exige decisão explícita.
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  createdAt   DateTime @default(now())

  // Listar "meus projetos" filtra por ownerId
  @@index([ownerId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  aggregateId String   @map("aggregate_id")
  aggregateType String @map("aggregate_type")
  eventType   String   @map("event_type")
  payload     Json
  // Envelope da gravação (eventId, actorId, correlationId, schemaVersion), separado do fato de domínio
  // (payload). JSONB para o envelope crescer sem migração. Eventos anteriores a esta coluna ficam com {}.
  metadata    Json     @default("{}")
  version     Int
  createdAt   DateTime @default(now()) @map("created_at")

  // Concorrência otimista garantida PELO BANCO: duas gravações com a mesma
  // versão no mesmo agregado → a segunda falha (P2002). Substitui o @@index
  // anterior: o índice único atende as mesmas consultas (WHERE aggregate_id ORDER BY version).
  @@unique([aggregateId, version])
  @@map("events")
}

// Transactional Outbox (Módulo 13.2): o evento de INTEGRAÇÃO a publicar no Kafka, gravado na MESMA transação
// dos eventos do Event Store. Ou os dois existem, ou nenhum: sem dual-write. Um relay (13.3) lê as pendentes e
// publica; at-least-once, com `event_id` como chave de idempotência dos consumers.
model OutboxMessage {
  // BIGSERIAL: ordem de leitura do relay. Entre transações concorrentes o id NÃO segue a ordem de commit, mas
  // para a MESMA tarefa as gravações são serializadas pela concorrência otimista, então a ordem por chave vale.
  id          BigInt    @id @default(autoincrement())
  // O mesmo `metadata.eventId` do Event Store: liga a mensagem ao evento e impede publicar o mesmo evento 2x
  eventId     String    @unique @map("event_id") @db.Uuid
  // Destino e chave já resolvidos na gravação: o relay fica genérico (não conhece Task)
  topic       String
  messageKey  String    @map("message_key")
  eventType   String    @map("event_type")
  // O contrato PÚBLICO (envelope + data), não o payload interno do Event Store
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  // NULL = pendente. Diferente da tabela `events`, a outbox é mutável: é fila de trabalho, não histórico
  publishedAt DateTime? @map("published_at")
  // Diagnóstico de uma linha travada (relay, 13.3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  // Contexto de trace W3C (`traceparent`/`tracestate`) de quem gravou o evento: o relay o continua e o põe nos
  // headers da mensagem, e o trace atravessa a outbox (Módulo 13). NULL = gravado fora de um span (scripts, seed)
  traceContext Json?    @map("trace_context")

  // Parcial: o relay só procura pendentes, e o índice não cresce com o que já foi publicado
  @@index([id], map: "outbox_pending_idx", where: raw("published_at IS NULL"))
  @@map("outbox")
}

model TaskRead {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  title      String
  // Enum (e não String): o banco recusa valores fora de PENDING | IN_PROGRESS | DONE
  status     TaskStatus   @default(PENDING)
  // Default só para preencher linhas antigas na migração; o handler sempre grava explicitamente
  priority   TaskPriority @default(MEDIUM)
  dueDate    DateTime?    @map("due_date")
  completedAt DateTime?   @map("completed_at")
  assigneeId String?  @map("assignee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@map("tasks_read")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}
// ============================================================
// Contexto de NOTIFICAÇÕES (Módulo 13.4) — dono: o consumer group `notifications` do Kafka
// ============================================================
// Fronteira por convenção: estas tabelas só são escritas pelo consumer, e o consumer NÃO lê nem escreve nas tabelas
// da API. Em microsserviços, seriam outro banco; aqui o mesmo Postgres, com a regra documentada no AGENTS.md.

// Idempotência do consumer: "este grupo já processou este evento?". Gravado na MESMA transação do efeito; uma
// reentrega (o Kafka é at-least-once) bate na PK e o efeito não se repete. A PK inclui o grupo: cada consumer group
// deduplica por conta própria (o `reports` da 13.6 processa o mesmo evento, independente deste).
model ProcessedEvent {
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at")

  @@id([consumerGroup, eventId])
  @@map("processed_events")
}

// Projeção LOCAL do consumer (taskId → título e responsável atual), alimentada pelos próprios eventos. O
// `TaskAssigned` e o `TaskCompleted` não trazem o título: em vez de consultar as tabelas da API, o consumer guarda o
// que precisa. A ordem por chave no Kafka garante que o `TaskCreated` chega antes dos outros eventos da tarefa.
model NotificationTask {
  taskId     String   @id @map("task_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  title      String
  assigneeId String?  @map("assignee_id") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("notification_tasks")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  // Destinatário. Sem FK para `User`: é outro contexto (o id chega pelo evento)
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  taskId    String           @map("task_id") @db.Uuid
  projectId String           @map("project_id") @db.Uuid
  message   String
  // Evento de origem: rastreabilidade ("de onde veio esta notificação?")
  eventId   String           @map("event_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  // A listagem `GET /me/notifications`: do usuário, mais recentes primeiro, `id` como desempate do cursor
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
}

// ============================================================
// Contexto de RELATÓRIOS (Módulo 13.6a) — dono: o consumer group `reports` do Kafka
// ============================================================
// Mesma fronteira do contexto de notificações: só o consumer escreve; a API só LÊ `project_stats`.
//
// Idempotência por VERSÃO do agregado, e não por tabela de marcas: `report_tasks.version` guarda a última versão
// aplicada de cada tarefa, e um evento com versão menor ou igual é duplicata (ou atrasado) e não muda nada. Uma linha
// por TAREFA, que não cresce com o número de eventos (o `processed_events` cresce).

// Estado de cada tarefa, só o que o cálculo dos deltas precisa: um `TaskStatusChanged` decrementa o contador de onde
// a tarefa SAIU, e isso só se sabe guardando o status atual
model ReportTask {
  taskId        String           @id @map("task_id") @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  status        ReportTaskStatus
  assigneeId    String?          @map("assignee_id") @db.Uuid
  // Instante de criação da tarefa (o `occurredAt` do TaskCreated): início do lead time
  taskCreatedAt DateTime         @map("task_created_at")
  // Última `aggregateVersion` aplicada: a guarda de idempotência
  version       Int
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("report_tasks")
}

// Contadores por projeto, atualizados por INCREMENTO atômico (`SET pending = pending + $delta`): tarefas do mesmo
// projeto caem em partições diferentes e atualizam esta linha em paralelo
model ProjectStats {
  projectId          String    @id @map("project_id") @db.Uuid
  total              Int       @default(0)
  pending            Int       @default(0)
  inProgress         Int       @default(0) @map("in_progress")
  done               Int       @default(0)
  // Tarefas abertas (não DONE) sem responsável
  unassignedOpen     Int       @default(0) @map("unassigned_open")
  // Soma dos lead times (criação → conclusão) das tarefas DONE, em segundos: média = soma / done
  leadTimeSecondsSum Float     @default(0) @map("lead_time_seconds_sum")
  // `occurredAt` do evento mais recente aplicado: o "dados até" que a API devolve (consistência eventual visível)
  lastEventAt        DateTime? @map("last_event_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  @@map("project_stats")
}

// Cópia própria dos status, e não o `TaskStatus` da API: outro contexto, que só conhece o contrato do tópico
enum ReportTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}
