generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  tasks     Task[]
  projects  Project[]
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Dono do projeto: base de toda regra de autorização (OWASP A01).
  // onDelete: Restrict → apagar um usuário com projetos exige decisão explícita.
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  createdAt   DateTime @default(now())

  // Listar "meus projetos" filtra por ownerId
  @@index([ownerId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  aggregateId String   @map("aggregate_id")
  aggregateType String @map("aggregate_type")
  eventType   String   @map("event_type")
  payload     Json
  version     Int
  createdAt   DateTime @default(now()) @map("created_at")

  // Concorrência otimista garantida PELO BANCO: duas gravações com a mesma
  // versão no mesmo agregado → a segunda falha (P2002). Substitui o @@index
  // anterior: o índice único atende as mesmas consultas (WHERE aggregate_id ORDER BY version).
  @@unique([aggregateId, version])
  @@map("events")
}

model TaskRead {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  title      String
  // Enum (e não String): o banco recusa valores fora de PENDING | IN_PROGRESS | DONE
  status     TaskStatus   @default(PENDING)
  // Default só para preencher linhas antigas na migração; o handler sempre grava explicitamente
  priority   TaskPriority @default(MEDIUM)
  dueDate    DateTime?    @map("due_date")
  completedAt DateTime?   @map("completed_at")
  assigneeId String?  @map("assignee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@map("tasks_read")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}