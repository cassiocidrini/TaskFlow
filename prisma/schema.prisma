generator client {
  provider        = "prisma-client-js"
  // partialIndexes: o índice das pendentes da outbox (WHERE published_at IS NULL) declarado AQUI. Criado só no
  // SQL da migração, o `migrate dev` o veria como drift e geraria um DROP INDEX na migração seguinte.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  tasks     Task[]
  projects  Project[]
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Dono do projeto: base de toda regra de autorização (OWASP A01).
  // onDelete: Restrict → apagar um usuário com projetos exige decisão explícita.
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  createdAt   DateTime @default(now())

  // Listar "meus projetos" filtra por ownerId
  @@index([ownerId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  aggregateId String   @map("aggregate_id")
  aggregateType String @map("aggregate_type")
  eventType   String   @map("event_type")
  payload     Json
  // Envelope da gravação (eventId, actorId, correlationId, schemaVersion), separado do fato de domínio
  // (payload). JSONB para o envelope crescer sem migração. Eventos anteriores a esta coluna ficam com {}.
  metadata    Json     @default("{}")
  version     Int
  createdAt   DateTime @default(now()) @map("created_at")

  // Concorrência otimista garantida PELO BANCO: duas gravações com a mesma
  // versão no mesmo agregado → a segunda falha (P2002). Substitui o @@index
  // anterior: o índice único atende as mesmas consultas (WHERE aggregate_id ORDER BY version).
  @@unique([aggregateId, version])
  @@map("events")
}

// Transactional Outbox (Módulo 13.2): o evento de INTEGRAÇÃO a publicar no Kafka, gravado na MESMA transação
// dos eventos do Event Store. Ou os dois existem, ou nenhum: sem dual-write. Um relay (13.3) lê as pendentes e
// publica; at-least-once, com `event_id` como chave de idempotência dos consumers.
model OutboxMessage {
  // BIGSERIAL: ordem de leitura do relay. Entre transações concorrentes o id NÃO segue a ordem de commit, mas
  // para a MESMA tarefa as gravações são serializadas pela concorrência otimista, então a ordem por chave vale.
  id          BigInt    @id @default(autoincrement())
  // O mesmo `metadata.eventId` do Event Store: liga a mensagem ao evento e impede publicar o mesmo evento 2x
  eventId     String    @unique @map("event_id") @db.Uuid
  // Destino e chave já resolvidos na gravação: o relay fica genérico (não conhece Task)
  topic       String
  messageKey  String    @map("message_key")
  eventType   String    @map("event_type")
  // O contrato PÚBLICO (envelope + data), não o payload interno do Event Store
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  // NULL = pendente. Diferente da tabela `events`, a outbox é mutável: é fila de trabalho, não histórico
  publishedAt DateTime? @map("published_at")
  // Diagnóstico de uma linha travada (relay, 13.3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  // Parcial: o relay só procura pendentes, e o índice não cresce com o que já foi publicado
  @@index([id], map: "outbox_pending_idx", where: raw("published_at IS NULL"))
  @@map("outbox")
}

model TaskRead {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  title      String
  // Enum (e não String): o banco recusa valores fora de PENDING | IN_PROGRESS | DONE
  status     TaskStatus   @default(PENDING)
  // Default só para preencher linhas antigas na migração; o handler sempre grava explicitamente
  priority   TaskPriority @default(MEDIUM)
  dueDate    DateTime?    @map("due_date")
  completedAt DateTime?   @map("completed_at")
  assigneeId String?  @map("assignee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@map("tasks_read")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}