# =============================================================
# TaskFlow — variáveis de ambiente
# Copie para .env:   cp .env.example .env   (Windows: copy .env.example .env)
# Validadas no boot por src/config/env.schema.ts — se algo estiver errado, a app não sobe.
# =============================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3000

# --- Banco de dados (PostgreSQL do docker-compose) --- OBRIGATÓRIO
DATABASE_URL="postgresql://taskflow:taskflow123@localhost:5432/taskflow_db?schema=public"

# --- Autenticação --- OBRIGATÓRIO
# Mínimo de 32 caracteres. Gere um segredo seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-troque-este-segredo-por-um-valor-aleatorio
JWT_EXPIRES_IN=1h

# --- CORS --- origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# false = JSON (formato de produção) · true = legível no terminal (pino-pretty, só em desenvolvimento)
LOG_PRETTY=true

# --- Graceful shutdown (ms) ---
# DRAIN: após o SIGTERM, continua atendendo com /health/ready = 503 (0 em dev; ~5000 em Kubernetes)
SHUTDOWN_DRAIN_MS=0
# TIMEOUT: força a saída se o encerramento travar (abaixo dos 10 s do `docker stop`)
SHUTDOWN_TIMEOUT_MS=8000

# --- Testes --- true desliga o rate limit (usado nos E2E e nos testes de carga)
DISABLE_THROTTLE=false

# --- Kafka (Módulo 13, opcional) --- só com `npm run streaming:up`. Por enquanto lido apenas pelos scripts
# (npm run kafka:smoke); a API passa a usá-lo no relay do outbox (13.3)
KAFKA_BROKERS=localhost:9092

# --- LocalStack (opcional) --- usado só pelo docker-compose; não é lido pela aplicação
LOCALSTACK_AUTH_TOKEN=
