{
  "uid": "taskflow-api",
  "title": "TaskFlow API",
  "description": "RED da API, banco e runtime Node. Provisionado por arquivo (grafana/dashboards/): mudanças via PR.",
  "tags": [
    "taskflow",
    "provisioned"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Tráfego HTTP (RED: rate, errors, duration) — probes /health/* não entram nestas métricas",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Requisições por segundo, por rota",
      "description": "Taxa de requisições por padrão de rota (http_route). Rota inexistente (404) aparece como (sem rota).",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (http_route) (rate(http_server_request_duration_count[$__rate_interval])), \"http_route\", \"(sem rota)\", \"http_route\", \"\")",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Respostas por status",
      "description": "Separa erro do cliente (4xx) de falha do servidor (5xx).",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_count[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Latência (p50, p95, p99)",
      "description": "Percentis de todas as rotas juntas. A média esconderia a cauda: o p99 é a experiência do pior 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Latência p95 por rota",
      "description": "Qual endpoint está lento. Só rotas conhecidas (http_route preenchido pelo RouteTelemetryGuard).",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{http_route!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Taxa de erro 5xx (%)",
      "description": "Porcentagem de respostas 5xx sobre o total. É o sinal de alerta de disponibilidade (SLO).",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_duration_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_count[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "type": "row",
      "id": 7,
      "title": "Banco de dados (PostgreSQL via pg)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Latência p95 das queries, por operação",
      "description": "Tempo de cada query no driver pg (SELECT, INSERT...). Sobe junto com a latência HTTP? O gargalo é o banco.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, db_operation_name) (rate(db_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{db_operation_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Conexões do pool: em uso × máximo",
      "description": "Em uso encostando no máximo = pool esgotado; as requisições passam a esperar conexão.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "sum(db_client_connection_count{db_client_connection_state=\"used\"})",
          "legendFormat": "em uso"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "B",
          "expr": "sum(db_client_connection_count{db_client_connection_state=\"idle\"})",
          "legendFormat": "ociosas"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "C",
          "expr": "sum(db_client_connection_max)",
          "legendFormat": "máximo"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Requisições esperando conexão",
      "description": "Acima de zero de forma sustentada: aumente o pool ou reduza o tempo das queries.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "sum(db_client_connection_pending_requests)",
          "legendFormat": "esperando"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Runtime Node.js",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Event loop: atraso p99",
      "description": "Quanto um callback espera para rodar. Alto = trabalho síncrono bloqueando o event loop (ver Módulo 11).",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "max(nodejs_eventloop_delay_p99)",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Event loop: utilização",
      "description": "Fração do tempo em que o event loop esteve ocupado. Perto de 100% = CPU-bound neste processo.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "max(nodejs_eventloop_utilization)",
          "legendFormat": "utilização"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Heap usado",
      "description": "Memória do heap do V8. Crescimento contínuo sem voltar após GC sugere vazamento.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "sum(v8js_memory_heap_used)",
          "legendFormat": "heap usado"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Tempo em GC por segundo",
      "description": "Segundos de pausa de garbage collection por segundo, por tipo.",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "refId": "A",
          "expr": "sum by (v8js_gc_type) (rate(v8js_gc_duration_sum[$__rate_interval]))",
          "legendFormat": "{{v8js_gc_type}}"
        }
      ]
    }
  ]
}
